<Window x:Class="ManagerSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager Setup" Width="1120" Height="760" MinWidth="940" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F5F7F9"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#18212B">
            <Grid Margin="28,30,24,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="MANAGER" Foreground="White" FontWeight="Bold" FontSize="21" />
                    <TextBlock Text="Windows Server Setup" Foreground="#AAB4BF" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Row="1" Height="1" Background="#33404D" Margin="0,26,0,24" />
                <StackPanel Grid.Row="2">
                    <Border x:Name="StepSource" Padding="12,10" Margin="0,0,0,5" CornerRadius="4">
                        <TextBlock x:Name="StepSourceText" Text="1   Package source" Foreground="#AAB4BF" FontSize="14" />
                    </Border>
                    <Border x:Name="StepServer" Padding="12,10" Margin="0,0,0,5" CornerRadius="4">
                        <TextBlock x:Name="StepServerText" Text="2   Server" Foreground="#AAB4BF" FontSize="14" />
                    </Border>
                    <Border x:Name="StepAccount" Padding="12,10" Margin="0,0,0,5" CornerRadius="4">
                        <TextBlock x:Name="StepAccountText" Text="3   Account &amp; data" Foreground="#AAB4BF" FontSize="14" />
                    </Border>
                    <Border x:Name="StepComponents" Padding="12,10" Margin="0,0,0,5" CornerRadius="4">
                        <TextBlock x:Name="StepComponentsText" Text="4   Components" Foreground="#AAB4BF" FontSize="14" />
                    </Border>
                    <Border x:Name="StepReview" Padding="12,10" Margin="0,0,0,5" CornerRadius="4">
                        <TextBlock x:Name="StepReviewText" Text="5   Review" Foreground="#AAB4BF" FontSize="14" />
                    </Border>
                    <Border x:Name="StepInstall" Padding="12,10" CornerRadius="4">
                        <TextBlock x:Name="StepInstallText" Text="6   Install" Foreground="#AAB4BF" FontSize="14" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <TextBlock Text="Manager 2.0" Foreground="#AAB4BF" FontSize="12" />
                    <TextBlock Text="Administrator access enabled" Foreground="#6EE7B7" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#E1E5EA" BorderThickness="0,0,0,1" Padding="38,25,38,22">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Choose the Manager package" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitle" Text="Install from a verified GitHub release or use the package embedded in this setup file."
                               Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,7,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="38,30,38,22">
                <Grid>
                    <Grid x:Name="SourcePanel">
                        <StackPanel MaxWidth="730" HorizontalAlignment="Left">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" Padding="20" CornerRadius="6" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="OnlineSourceRadio" GroupName="PackageSource" Checked="SourceMode_Checked" VerticalAlignment="Top" Margin="0,3,15,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Online installation" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Download an immutable, versioned package from GitHub Releases and verify its checksum."
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" Padding="20" CornerRadius="6" Margin="0,0,0,24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="OfflineSourceRadio" GroupName="PackageSource" IsChecked="True" Checked="SourceMode_Checked" VerticalAlignment="Top" Margin="0,3,15,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Embedded package (recommended)" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Install the verified Manager version included in this setup file. No GitHub release or token is required. Internet is still needed to install dependencies."
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid x:Name="OnlineFields">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="210" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="GitHub repository" />
                                    <TextBox x:Name="RepositoryTextBox" Text="elimichaells/synergy-deployer" />
                                    <TextBlock Text="Use owner/repository. Releases must include the ZIP and its SHA-256 manifest."
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Release" />
                                    <TextBox x:Name="ReleaseTagTextBox" Text="latest" />
                                    <TextBlock Text="Use latest or a release tag." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.ColumnSpan="3" Margin="0,96,0,0">
                                    <Label Content="GitHub token (optional for private repositories)" />
                                    <PasswordBox x:Name="GitHubTokenPasswordBox" />
                                    <TextBlock Text="The token stays in memory for this session and is never written to the setup configuration or logs."
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ServerPanel" Visibility="Collapsed">
                        <StackPanel MaxWidth="730" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="Manager domain" />
                                    <TextBox x:Name="DomainTextBox" />
                                    <TextBlock Text="DNS should resolve to this Windows server before public TLS can complete."
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Manager port" />
                                    <TextBox x:Name="PortTextBox" Text="4000" />
                                    <TextBlock Text="Loopback application port" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,28,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="Manager installation directory" />
                                    <TextBox x:Name="ManagerRootTextBox" Text="C:\web\manager" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Application web root" />
                                    <TextBox x:Name="WebRootTextBox" Text="C:\web" />
                                </StackPanel>
                            </Grid>
                            <Border Background="#EDF8F6" BorderBrush="#A7D9D2" BorderThickness="1" Padding="16" CornerRadius="5" Margin="0,30,0,0">
                                <TextBlock Text="Caddy will terminate HTTPS on ports 80 and 443. Database ports remain loopback-only and are not opened in Windows Firewall."
                                           Foreground="#185B55" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="AccountPanel" Visibility="Collapsed">
                        <StackPanel MaxWidth="730" HorizontalAlignment="Left">
                            <TextBlock Text="Initial administrator" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="Name" />
                                    <TextBox x:Name="AdminNameTextBox" Text="Administrator" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Email" />
                                    <TextBox x:Name="AdminEmailTextBox" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="Administrator password" />
                                    <PasswordBox x:Name="AdminPasswordBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Confirm password" />
                                    <PasswordBox x:Name="AdminPasswordConfirmBox" />
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,30,0,25" />
                            <TextBlock Text="Database credentials" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="Manager generates separate application-role and project-cluster secrets. Enter the PostgreSQL administrator password used to create the control database."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />
                            <Label Content="PostgreSQL administrator password" />
                            <PasswordBox x:Name="DbAdminPasswordBox" MaxWidth="354" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ComponentsPanel" Visibility="Collapsed">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Core services" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18" />
                                    <CheckBox x:Name="InstallPostgresCheckBox" IsChecked="True" Content="PostgreSQL control database" />
                                    <CheckBox x:Name="InstallAppPostgresCheckBox" IsChecked="True" Content="Isolated project PostgreSQL cluster" />
                                    <CheckBox x:Name="InstallPgwebCheckBox" IsChecked="True" Content="Pgweb for PostgreSQL" />
                                    <CheckBox x:Name="LatestNpmCheckBox" IsChecked="True" Content="Current npm release" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Project runtimes" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18" />
                                    <CheckBox x:Name="GoCheckBox" IsChecked="True" Content="Go" />
                                    <CheckBox x:Name="PhpCheckBox" IsChecked="True" Content="PHP" />
                                    <CheckBox x:Name="ComposerCheckBox" IsChecked="True" Content="Composer" />
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,22,0,24" />
                            <TextBlock Text="Optional project database engines" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="Choose MySQL or MariaDB for automatic installation; they share the default service and port. Either choice also installs the secured phpMyAdmin web client."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="MySqlCheckBox" Content="MySQL" Checked="DatabaseEngine_Checked" />
                                <CheckBox x:Name="MariaDbCheckBox" Content="MariaDB" Checked="DatabaseEngine_Checked" />
                                <CheckBox x:Name="MongoDbCheckBox" Content="MongoDB" />
                                <CheckBox x:Name="SqlServerCheckBox" Content="SQL Server Express" />
                            </UniformGrid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ReviewPanel" Visibility="Collapsed">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <Border Background="#FFF8E8" BorderBrush="#E8CD83" BorderThickness="1" Padding="16" CornerRadius="5" Margin="0,0,0,22">
                                <TextBlock Text="Setup will first download or unpack the selected release, verify its checksum, and run a read-only server preflight. Installation remains disabled until that preflight passes."
                                           Foreground="#644E13" TextWrapping="Wrap" />
                            </Border>
                            <TextBox x:Name="ReviewTextBox" IsReadOnly="True" IsTabStop="False" MinHeight="330"
                                     FontFamily="Consolas" FontSize="13" Background="White" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Padding="18" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="InstallPanel" Visibility="Collapsed">
                        <Grid MaxWidth="800" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="InstallStatusText" Text="Preparing preflight..." FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="InstallDetailText" Text="Package verification and server checks will appear below."
                                           Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ProgressBar x:Name="InstallProgressBar" Grid.Row="1" Height="5" Margin="0,20,0,18"
                                         IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" />
                            <TextBox x:Name="InstallLogTextBox" Grid.Row="2" MinHeight="380" IsReadOnly="True" IsTabStop="False"
                                     FontFamily="Consolas" FontSize="12" Background="#111820" Foreground="#DDE5ED"
                                     BorderThickness="0" Padding="16" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="White" BorderBrush="#E1E5EA" BorderThickness="0,1,0,0" Padding="38,17">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BackButton" Content="Back" Style="{StaticResource SecondaryButton}" Click="BackButton_Click" />
                        <Button x:Name="UseEmbeddedPackageButton" Content="Use embedded package" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Click="UseEmbeddedPackageButton_Click" />
                        <Button x:Name="CancelOperationButton" Content="Cancel operation" Style="{StaticResource SecondaryButton}"
                                Margin="12,0,0,0" Visibility="Collapsed" Click="CancelOperationButton_Click" />
                    </StackPanel>
                    <Button x:Name="NextButton" Content="Continue" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Click="NextButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
